{
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "github.com",
      "api.github.com",
      "pypi.org",
      "files.pythonhosted.org",
      "trunk.io",
      "api.trunk.io",
      "docs.getdbt.com",
      "docs.cloud.google.com",
      "cloud.google.com",
      "docs.astral.sh",
      "code.claude.com",
      "hub.getdbt.com"
    ]
  },
  "additionalReadwritePaths": [
    "//tmp",
    "./.pytest_cache",
    "./.trunk",
    "./build",
    "./dist"
  ]
}
